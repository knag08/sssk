---
/** Small lotus ornament — the site's recurring section divider. */
interface Props {
  class?: string;
}
const { class: className = 'h-6 w-auto text-gold-400' } = Astro.props;
---

<svg viewBox="0 0 120 28" fill="none" class={className} aria-hidden="true" focusable="false">
  <path d="M0 14h34" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity=".45"></path>
  <path d="M86 14h34" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity=".45"></path>
  <!-- centre petal -->
  <path d="M60 4c3.4 3.6 5.1 7 5.1 10s-1.7 6-5.1 9.4C56.6 20 54.9 17 54.9 14S56.6 7.6 60 4Z" fill="currentColor"
  ></path>
  <!-- side petals -->
  <path
    d="M60 23.4c-4.5.6-8-.2-10.5-2.3s-3.9-5.3-4.2-9.5c4 1.3 7 3 9 5.2 2 2.1 3.6 4.3 5.7 6.6Z"
    fill="currentColor"
    opacity=".72"></path>
  <path
    d="M60 23.4c4.5.6 8-.2 10.5-2.3s3.9-5.3 4.2-9.5c-4 1.3-7 3-9 5.2-2 2.1-3.6 4.3-5.7 6.6Z"
    fill="currentColor"
    opacity=".72"></path>
  <path d="M42.5 14a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0Z" fill="currentColor" opacity=".55"></path>
  <path d="M81.9 14a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0Z" fill="currentColor" opacity=".55"></path>
</svg>
