---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SevaIcon from '../../components/SevaIcon.astro';
import Lotus from '../../components/Lotus.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import CallToAction from '../../components/CallToAction.astro';

export async function getStaticPaths() {
  const entries = await getCollection('seva');
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'seva'>;
  next: CollectionEntry<'seva'>;
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={d.title} description={d.summary}>
  {/* --------------------------------------------------------------- Hero */}
  <section class="relative isolate overflow-hidden bg-ink-950">
    <Image
      src={d.cover}
      alt={d.coverAlt}
      widths={[900, 1400, 1900]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950/88 via-ink-950/72 to-ink-950/96"></div>

    <div class="relative mx-auto max-w-7xl px-5 pt-32 pb-16 sm:px-8 sm:pt-40 sm:pb-20 lg:pt-44">
      <a
        href="/seva/"
        class="inline-flex items-center gap-1.5 text-[0.78rem] font-semibold tracking-wide text-gold-300 transition hover:text-gold-200"
      >
        <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 10H5m0 0 4.2-4.2M5 10l4.2 4.2"></path>
        </svg>
        All seva
      </a>

      <div class="mt-8 flex max-w-3xl flex-col gap-6">
        <span
          class="inline-grid h-14 w-14 place-items-center rounded-full bg-white/10 text-gold-200 ring-1 ring-white/20 ring-inset"
        >
          <SevaIcon name={d.icon} class="h-6 w-6" />
        </span>
        <h1 class="text-[2.35rem] leading-[1.08] font-semibold text-white sm:text-[3.1rem]">{d.title}</h1>
        <p class="max-w-2xl text-[1.05rem] leading-relaxed text-ink-100/80 sm:text-[1.15rem]">{d.subtitle}</p>
      </div>

      <dl class="mt-12 grid max-w-3xl gap-6 border-t border-white/15 pt-8 sm:grid-cols-2">
        <div>
          <dt class="text-[0.68rem] font-semibold tracking-[0.16em] text-gold-300 uppercase">When</dt>
          <dd class="mt-2 text-[0.98rem] text-white/85">{d.cadence}</dd>
        </div>
        <div>
          <dt class="text-[0.68rem] font-semibold tracking-[0.16em] text-gold-300 uppercase">Where</dt>
          <dd class="mt-2 text-[0.98rem] text-white/85">{d.place}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* -------------------------------------------------------------- Facts */}
  {
    d.facts.length > 0 && (
      <Section space="sm">
        <div class="grid gap-px overflow-hidden rounded-2xl bg-ink-900/10 sm:grid-cols-2 lg:grid-cols-4">
          {d.facts.map((f) => (
            <div class="reveal bg-paper p-7">
              <p class="font-display text-[1.9rem] leading-none font-semibold text-ink-900 tabular-nums">{f.value}</p>
              <p class="mt-3 text-[0.88rem] leading-snug text-ink-600">{f.label}</p>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  {/* ------------------------------------------------------------- Story */}
  <Section space={d.facts.length > 0 ? 'md' : 'lg'}>
    <div class="mx-auto max-w-3xl">
      <div class="prose-kuteer reveal text-[1.06rem] sm:text-[1.1rem]">
        <Content />
      </div>
    </div>
  </Section>

  {/* -------------------------------------------------------------- Steps */}
  {
    d.steps.length > 0 && (
      <Section tone="deep" space="md">
        <div class="mx-auto max-w-3xl text-center">
          <Lotus class="mx-auto h-5 w-auto text-gold-400" />
          <h2 class="mt-7 text-[1.9rem] leading-tight font-semibold sm:text-[2.3rem]">How it works</h2>
        </div>

        <ol class="mx-auto mt-14 grid max-w-5xl gap-6 sm:grid-cols-2">
          {d.steps.map((step, i) => (
            <li class="reveal relative rounded-2xl bg-paper p-7 ring-1 ring-ink-900/8 sm:p-8">
              <span class="font-display text-[0.95rem] font-semibold text-gold-700 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-[1.15rem] font-semibold">{step.title}</h3>
              <p class="mt-2.5 text-[0.94rem] leading-relaxed text-ink-600">{step.text}</p>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {/* ------------------------------------------------------------ Gallery */}
  {
    d.gallery.length > 0 && (
      <Section space="md">
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Photographs</p>
            <h2 class="mt-3 text-[1.75rem] leading-tight font-semibold sm:text-[2.1rem]">{d.title} in action</h2>
          </div>
          <p class="text-[0.82rem] text-ink-500">Tap any photograph to enlarge</p>
        </div>
        <div class="mt-10">
          <PhotoGrid photos={d.gallery} columns={4} />
        </div>
      </Section>
    )
  }

  {/* --------------------------------------------------------------- Next */}
  <Section tone="deep" space="sm">
    <a
      href={`/seva/${next.id}/`}
      class="group reveal flex flex-col gap-6 rounded-2xl bg-paper p-8 ring-1 ring-ink-900/8 transition hover:ring-ink-900/20 sm:flex-row sm:items-center sm:justify-between sm:p-10"
    >
      <div>
        <p class="eyebrow">Next</p>
        <h2 class="mt-3 text-[1.6rem] font-semibold sm:text-[1.9rem]">{next.data.title}</h2>
        <p class="mt-2 max-w-xl text-[0.94rem] leading-relaxed text-ink-600">{next.data.summary}</p>
      </div>
      <span
        class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-ink-950 text-white transition-transform duration-300 group-hover:translate-x-1"
      >
        <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h11m0 0-4.2-4.2M15 10l-4.2 4.2"></path>
        </svg>
      </span>
    </a>
  </Section>

  <CallToAction
    title="Help keep this running."
    text="Every one of these services is free at the point of need, and stays that way only because people give their time, their skills and their means."
    primary={{ href: '/get-involved/', label: 'Ways to help' }}
    secondary={{ href: '/contact/', label: 'Talk to us' }}
  />

  <Lightbox />
</BaseLayout>
