---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CallToAction from '../components/CallToAction.astro';
import { categories, countFor, photos } from '../data/photos';

import heroImage from '../assets/photos/monthly-narayana-seva-dining-01.jpg';

const visible = categories.filter((c) => countFor(c.id) > 0);
---

<BaseLayout
  title="Gallery"
  description="Photographs from a year of service at Sri Sathya Sai Kuteer — Narayana Seva, free medical camps, evening tuition, drinking water, and Vanara Seva."
>
  <PageHero
    eyebrow="Photographs"
    title="A year, as it looked"
    lede="Every photograph here was taken at the Kuteer or on one of its rounds. Nothing is staged, and nobody was asked to pose."
    image={heroImage}
    imageAlt="Guests seated together for lunch during the monthly Narayana Seva"
  />

  <Section space="md">
    {/* Filters */}
    <div class="reveal -mx-5 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0" data-filter-bar>
      <div class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
        {
          visible.map((c, i) => (
            <button
              type="button"
              data-filter={c.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class:list={[
                'rounded-full border px-4 py-2 text-[0.83rem] font-medium whitespace-nowrap transition',
                i === 0
                  ? 'border-ink-950 bg-ink-950 text-white'
                  : 'border-ink-900/15 bg-white text-ink-700 hover:border-ink-900/35',
              ]}
            >
              {c.label}
              <span class="ml-1.5 text-[0.72rem] opacity-75 tabular-nums">{countFor(c.id)}</span>
            </button>
          ))
        }
      </div>
    </div>

    <p class="mt-6 text-[0.85rem] text-ink-500" data-filter-status aria-live="polite">
      Showing all {photos.length} photographs. Tap any one to enlarge.
    </p>

    <div class="mt-8">
      <PhotoGrid photos={photos} columns={4} />
    </div>

    <p class="mt-12 border-t border-ink-900/10 pt-8 text-[0.82rem] leading-relaxed text-ink-500">
      These photographs belong to Sri Sathya Sai Kuteer and are published here as a record of its work. Please write to
      us before reproducing any of them elsewhere.
    </p>
  </Section>

  <CallToAction
    title="Be in next year's photographs."
    text="The kitchen starts early, the camps need hands at the registration desk, and the evening classes always need another tutor."
    primary={{ href: '/get-involved/', label: 'Volunteer with us' }}
    secondary={{ href: '/seva/', label: 'Our activities' }}
  />

  <Lightbox />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-photo-grid] figure'));

  const idle = ['border-ink-900/15', 'bg-white', 'text-ink-700', 'hover:border-ink-900/35'];

  bar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button) return;

    const wanted = button.dataset.filter!;

    bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      const on = b === button;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('border-ink-950', on);
      b.classList.toggle('bg-ink-950', on);
      b.classList.toggle('text-white', on);
      idle.forEach((c) => b.classList.toggle(c, !on));
    });

    let shown = 0;
    figures.forEach((fig) => {
      const match = wanted === 'all' || fig.dataset.category === wanted;
      fig.hidden = !match;
      if (match) shown += 1;
    });

    if (status) {
      const label = button.textContent?.replace(/\d+\s*$/, '').trim() ?? '';
      status.textContent =
        wanted === 'all'
          ? `Showing all ${shown} photographs. Tap any one to enlarge.`
          : `Showing ${shown} ${shown === 1 ? 'photograph' : 'photographs'} from ${label}.`;
    }
  });
</script>
